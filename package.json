{
  "name": "midad",
  "private": true,
  "description": "Midad (مِداد) — aplikasi belajar bahasa Arab bergaya game",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "workbox-build": { "glob": "^14.0.2" }
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:paket": "node scripts/build-paket.mjs",
    "check": "node scripts/build-css.mjs --check && node scripts/check-mascot.mjs && node scripts/check-data.mjs",
    "preview:ds": "node scripts/serve.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "npm run check && npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
